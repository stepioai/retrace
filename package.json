{
  "name": "retrace-test-app",
  "version": "1.0.0",
  "private": true,
  "description": "A small fake SaaS app for testing Stepio Retrace. Its UI changes through environment variables.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
