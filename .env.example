# Copy to .env for local runs. `npm run dev` loads it; `npm start` does not.

# Preset: v1 | cosmetic | v2 | v3 | v4
UI_VERSION=v2

# Login: password | two_step | otp | sso_only | captcha
LOGIN_MODE=password

# The one fake account
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234
TOTP_SECRET=JBSWY3DPEHPK3PXP

# Signs the session cookie. Set any long random string when deployed.
SESSION_SECRET=change-me

# Single overrides (leave empty to use the preset's value)
NAV_LAYOUT=
NEW_PROJECT_PLACEMENT=
LABEL_NEW_PROJECT=
LABEL_CREATE=
LABEL_SAVE=
LABEL_INVITE=
LOGIN_HEADING=
LOGIN_SUBTITLE=
LABEL_SIGN_IN=
STABLE_IDS=
PROJECT_WIZARD=
SETTINGS_PATH=
TEAM_PAGE=
ACCENT_COLOR=
BANNER_TEXT=
